{
  "name": "worker-desk-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --port 8787 --local",
    "build": "node scripts/build-assets.mjs",
    "preflight": "node scripts/preflight.mjs",
    "deploy": "node scripts/preflight.mjs && npm run build && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply worker-desk --local",
    "migrate:remote": "wrangler d1 migrations apply worker-desk --remote"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
